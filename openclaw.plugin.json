// Revere for OpenClaw: a manifest and one small piece of code (src/index.js). The manifest adds Revere's MCP server and
// the skills; the code gives the server its address and key from the plugin's settings.
// Native manifests are parsed as JSON5, so comments are allowed.
//
// Checked against OpenClaw 2026.11.10: see docs/verification.md.
{
  "id": "revere",
  "name": "Revere",
  "description": "See your Revere cameras from OpenClaw: live pictures, what was detected, stories and clips. Read-only.",
  "version": "0.1.0",
  "categories": ["security", "media", "integrations"],

  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["token"],
    "properties": {
      "token": {
        "type": "string",
        "minLength": 16,
        "pattern": "^\\S+$",
        "description": "A read-only Revere MCP key. Make one in Revere (Integrations, AI assistant). It is shown once."
      },
      "apiUrl": {
        "type": "string",
        "default": "https://api.revere.video",
        "pattern": "^https://[^\\s/?#@\\\\]+/?$",
        "description": "Revere's address. https only: a host and a port, no path (a trailing slash is fine), no user name, query or fragment."
      },
      "cameras": {
        "type": "array",
        "maxItems": 50,
        "items": { "type": "string", "minLength": 1 },
        "description": "Camera ids the agent should use. This guides the model only: the key itself can read every camera on the account."
      }
    }
  },

  "uiHints": {
    "token": { "label": "Revere read-only key", "placeholder": "paste the key Revere showed you", "sensitive": true },
    "apiUrl": { "label": "Revere address", "advanced": true },
    "cameras": { "label": "Prefer these cameras (ids). Guides the model; the key is account-wide.", "advanced": true }
  },

  "skills": ["skills"],

  // Declared here so the server has a name and the skills can use it. OpenClaw does not expand ${config.*} in this
  // block (only ${PLUGIN_ROOT}, ${PLUGIN_DATA} and ${CLAUDE_PLUGIN_ROOT}), so the connection's real address and
  // key come from src/index.js, which registers a resolver for this name.
  "mcpServers": {
    "revere": {
      "transport": "streamable-http",
      "url": "https://api.revere.video/mcp"
    }
  },

  "recommendedPrompts": [
    "What is happening at my front door right now?",
    "Tell me when a package arrives.",
    "Summarize my yard each evening."
  ]
}
